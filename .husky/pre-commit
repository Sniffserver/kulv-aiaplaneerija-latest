#!/bin/sh
. "$(dirname "$0")/_/husky.sh" 2>/dev/null || true

# Block committing forbidden lockfiles or unignored secrets
if git diff --cached --name-only 2>/dev/null | grep -E '(bun\.lock|yarn\.lock|pnpm-lock|\.env($|\.local|\.production))' > /dev/null; then
  echo "❌ Error: Forbidden lockfile or environment secret file staged. Aborting commit."
  exit 1
fi

npx lint-staged
npm run typecheck
