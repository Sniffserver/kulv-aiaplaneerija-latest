# Required for /api/weather
OPENWEATHER_API_KEY=

# Optional: comma-separated exact origins.
# Example: https://kulv.example.com,https://www.kulv.example.com
# In non-production, standard localhost/preview origins are allowed automatically.
CORS_ORIGINS=

# Optional: defaults to 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production.
HOST=

# Optional: defaults to 3000.
PORT=

# Optional: development or production.
NODE_ENV=

